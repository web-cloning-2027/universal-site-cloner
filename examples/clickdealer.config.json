{
  "name": "clickdealer",
  "displayName": "ClickDealer DMS (proving ground; dual-domain)",
  "auth": {
    "strategy": "CookieJarAuth",
    "statePath": "~/.config/universal-site-cloner-sessions/clickdealer/state.json"
  },
  "crawler": {
    "seedUrls": [
      "https://dms.myclickdealer.co.uk/",
      "https://myclickdealer.co.uk/home.php",
      "https://myclickdealer.co.uk/diary.php",
      "https://myclickdealer.co.uk/onetrue_list.php",
      "https://myclickdealer.co.uk/user_list.php",
      "https://myclickdealer.co.uk/sales_enquiries.php",
      "https://myclickdealer.co.uk/work_list.php",
      "https://myclickdealer.co.uk/calendar.php",
      "https://myclickdealer.co.uk/pdi_list.php"
    ],
    "allowlistRegex": "^https://(dms\\.)?myclickdealer\\.co\\.uk/",
    "dedupe": [
      { "pattern": "\\?id=\\d+", "replace": "?id=:id" },
      { "pattern": "\\?vehicle_id=\\d+", "replace": "?vehicle_id=:id" },
      { "pattern": "&vehicle_id=\\d+", "replace": "&vehicle_id=:id" },
      { "pattern": "\\?enquiry_id=\\d+", "replace": "?enquiry_id=:id" },
      { "pattern": "&enquiry_id=\\d+", "replace": "&enquiry_id=:id" },
      { "pattern": "\\?customer_id=\\d+", "replace": "?customer_id=:id" },
      { "pattern": "\\?registration=[A-Z0-9 %]+", "replace": "?registration=:reg" },
      { "pattern": "\\?vrm=[A-Z0-9 %]+", "replace": "?vrm=:reg" },
      { "pattern": "&vrm=[A-Z0-9 %]+", "replace": "&vrm=:reg" },
      { "pattern": "\\?job_card_id=\\d+,?(&action=[^&]*)?", "replace": "?job_card_id=:id" },
      { "pattern": "\\?type_id=\\d+&vehicle_id=&enquiry_source_id=", "replace": "?type_id=:id&vehicle_id=&enquiry_source_id=" },
      { "pattern": "\\?month=\\d+&year=\\d+&type_id=\\d+&technician_id=\\d+&location_id=&", "replace": "?month=:m&year=:y&type_id=:t&technician_id=:n&location_id=&" },
      { "pattern": "\\?timestamp_from=[0-9/]+&timestamp=[0-9/]+(&cat=\\d+)?", "replace": "?timestamp_from=:d&timestamp=:d&cat=:c" },
      { "pattern": "\\?timestamp=\\d{8,}(&type_id=\\d+)?", "replace": "?timestamp=:ts&type_id=:t" },
      { "pattern": "&timestamp=\\d{8,}", "replace": "&timestamp=:ts" },
      { "pattern": "&timestamp_from=\\d{8,}", "replace": "&timestamp_from=:ts" },
      { "pattern": "\\?collection_date_from=-?\\d+&collection_date=-?\\d+(&type=\\d+)?", "replace": "?collection_date_from=:ts&collection_date=:ts&type=:t" },
      { "pattern": "\\?timestamp=\\d+&type_id=\\d+&technician_id=\\d+&location_id=", "replace": "?timestamp=:ts&type_id=:t&technician_id=:n&location_id=" },
      { "pattern": "\\?month=\\d+&year=\\d+", "replace": "?month=:m&year=:y" },
      { "pattern": "&month=\\d+", "replace": "&month=:m" },
      { "pattern": "&year=\\d+", "replace": "&year=:y" },
      { "pattern": "/image_manager/\\d+", "replace": "/image_manager/:id" },
      { "pattern": "/vehicles/\\d+", "replace": "/vehicles/:id" },
      { "pattern": "/customers/\\d+", "replace": "/customers/:id" },
      { "pattern": "/enquiries/\\d+", "replace": "/enquiries/:id" },
      { "pattern": "/diary/\\d+", "replace": "/diary/:id" }
    ],
    "retryBackoffMs": 1000,
    "maxRetries": 4,
    "navigationTimeoutMs": 40000,
    "serial": true
  },
  "hints": {
    "endpointPatterns": [
      "/.*_print\\.php(?:[?#]|$)",
      "/.*_csv\\.php(?:[?#]|$)",
      "/.*_pdf\\.php(?:[?#]|$)",
      "/xml_export\\.php(?:[?#]|$)",
      "/downloads/",
      "/blog/",
      "/api/",
      "/hmrc/auth\\.php(?:[?#]|$)",
      "/configure-redirect\\.php(?:[?#]|$)",
      "/_a_",
      "\\.csv(?:[?#]|$)",
      "\\.xml(?:[?#]|$)",
      "\\.pdf(?:[?#]|$)",
      "/sort_images\\.php",
      "/vehicle_spec_print\\.php",
      "/keytag_print\\.php",
      "/aftersales_jobcard_print\\.php",
      "/aftersales_jobcard_list_print\\.php",
      "/invoice_print\\.php",
      "/pdi_actions_report_pdf\\.php",
      "/quote_print\\.php"
    ],
    "sectionLandingPatterns": [
      "^https://dms\\.myclickdealer\\.co\\.uk/$",
      "^https://myclickdealer\\.co\\.uk/$"
    ],
    "shapeOverrides": []
  },
  "visualDiffThresholdPct": 12
}
