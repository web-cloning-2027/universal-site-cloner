{
  "name": "clickdealer",
  "displayName": "ClickDealer DMS (proving ground; dual-domain)",
  "auth": {
    "strategy": "CookieJarAuth",
    "statePath": "~/.config/universal-site-cloner-sessions/clickdealer/state.json"
  },
  "crawler": {
    "seedUrls": [
      "https://dms.myclickdealer.co.uk/",
      "https://myclickdealer.co.uk/home.php",
      "https://myclickdealer.co.uk/diary.php",
      "https://myclickdealer.co.uk/onetrue_list.php",
      "https://myclickdealer.co.uk/user_list.php",
      "https://myclickdealer.co.uk/sales_enquiries.php",
      "https://myclickdealer.co.uk/work_list.php",
      "https://myclickdealer.co.uk/diary.php",
      "https://myclickdealer.co.uk/calendar.php",
      "https://myclickdealer.co.uk/pdi_list.php",
      "https://myclickdealer.co.uk/aftersales_details.php"
    ],
    "allowlistRegex": "^https://(dms\\.)?myclickdealer\\.co\\.uk/",
    "dedupe": [
      { "pattern": "vehicle_details\\.php\\?id=\\d+", "replace": "vehicle_details.php?id=:id" },
      { "pattern": "order\\.php\\?enquiry_id=\\d+", "replace": "order.php?enquiry_id=:id" },
      { "pattern": "aftersales_jobcard_details\\.php\\?id=\\d+", "replace": "aftersales_jobcard_details.php?id=:id" },
      { "pattern": "aftersales_job_quotation_details\\.php\\?id=\\d+", "replace": "aftersales_job_quotation_details.php?id=:id" },
      { "pattern": "invoice_details\\.php\\?id=\\d+", "replace": "invoice_details.php?id=:id" },
      { "pattern": "customer_details\\.php\\?id=\\d+", "replace": "customer_details.php?id=:id" },
      { "pattern": "/vehicles/\\d+", "replace": "/vehicles/:id" },
      { "pattern": "/customers/\\d+", "replace": "/customers/:id" },
      { "pattern": "/enquiries/\\d+", "replace": "/enquiries/:id" },
      { "pattern": "/diary/\\d+", "replace": "/diary/:id" }
    ],
    "retryBackoffMs": 1000,
    "maxRetries": 4,
    "navigationTimeoutMs": 40000,
    "serial": true
  },
  "hints": {
    "endpointPatterns": [
      "/.*_print\\.php(?:\\?|$)",
      "/.*_csv\\.php(?:\\?|$)",
      "/xml_export\\.php(?:\\?|$)",
      "/downloads/",
      "/blog/",
      "/api/",
      "/hmrc/auth\\.php(?:\\?|$)",
      "/configure-redirect\\.php(?:\\?|$)",
      "/_a_",
      "\\.csv(?:\\?|$)",
      "\\.xml(?:\\?|$)",
      "\\.pdf(?:\\?|$)"
    ],
    "sectionLandingPatterns": [
      "^https://dms\\.myclickdealer\\.co\\.uk/$",
      "^https://myclickdealer\\.co\\.uk/$"
    ],
    "shapeOverrides": []
  },
  "visualDiffThresholdPct": 12
}
